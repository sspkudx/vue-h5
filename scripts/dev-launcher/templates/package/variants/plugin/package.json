{
    "name": "@my-app/{{package-name}}",
    "version": "1.0.0",
    "description": "{{description}}",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "development": {
                "types": "./src/index.ts",
                "default": "./src/index.ts"
            },
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "dev": "bash ../../scripts/watch-package.sh",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [
        "vue",
        "plugin",
        "extension"
    ],
    "author": "",
    "license": "MIT",
    "peerDependencies": {
        "vue": "catalog:",
        "pinia": "catalog:",
        "vue-router": "catalog:"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "catalog:",
        "@vue/test-utils": "catalog:",
        "rimraf": "^6.1.3",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
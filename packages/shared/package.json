{
    "name": "@my-app/shared",
    "version": "1.0.0",
    "description": "vue-h5 共享工具库：类型守卫与数字工具",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "development": {
                "types": "./src/index.ts",
                "default": "./src/index.ts"
            },
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "dev": "bash ../../scripts/watch-package.sh",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [],
    "author": "",
    "license": "MIT"
}

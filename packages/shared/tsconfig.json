{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsxFactory": "h",
        "jsxFragmentFactory": "Fragment",
        // TS 6.0 起 types 默认为 []，jest 全局（describe/test/expect）与 node 类型需显式声明
        "types": ["jest", "node"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "types/*.d.ts",
        "../../types/*.d.ts",
        "vite.config.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}

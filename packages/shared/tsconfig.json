{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsxFactory": "h",
        "jsxFragmentFactory": "Fragment",
        "baseUrl": "./"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "types/*.d.ts",
        "../../types/*.d.ts",
        "vite.config.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}

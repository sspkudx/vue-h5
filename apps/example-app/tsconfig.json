{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["webpack-env"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "tests/**/*.ts", "tests/**/*.tsx", "types/*.d.ts", "../../types/*.d.ts"],
    "exclude": ["node_modules"]
}

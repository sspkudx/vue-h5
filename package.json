{
    "name": "vue-h5",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
    "scripts": {
        "predev": "pnpm -F dev-launcher-web build",
        "dev": "node scripts/dev-launcher/index.mjs",
        "dev:cli": "node scripts/dev-launcher/index.mjs --cli",
        "build:launcher": "pnpm -F dev-launcher-web build",
        "dev:example": "./scripts/build-packages.sh --skip-clean && pnpm -F example-app dev",
        "build:example": "pnpm -F example-app build",
        "build:shared": "pnpm -F @my-app/shared build",
        "build:packages": "./scripts/build-packages.sh",
        "build": "sh ./scripts/build.sh",
        "lint": "eslint \"apps/**/src/**/*.{js,jsx,ts,tsx,vue}\" \"packages/**/src/**/*.{js,jsx,ts,tsx}\" \"scripts/dev-launcher/web/src/**/*.{js,jsx,ts,tsx,vue}\"",
        "lint:fix": "eslint \"apps/**/src/**/*.{js,jsx,ts,tsx,vue}\" \"packages/**/src/**/*.{js,jsx,ts,tsx}\" \"scripts/dev-launcher/web/src/**/*.{js,jsx,ts,tsx,vue}\" --fix",
        "lint:example": "pnpm -F example-app lint",
        "lint:style": "stylelint \"**/*.{css,less,vue}\"",
        "lint:style:fix": "stylelint \"**/*.{css,less,vue}\" --fix",
        "format": "prettier --write \"apps/**/src/**/*.{js,jsx,ts,tsx,vue,css,less,scss}\" \"packages/**/src/**/*.{js,jsx,ts,tsx}\" \"scripts/dev-launcher/web/src/**/*.{js,jsx,ts,tsx,vue,css}\" \"*.{js,jsx,ts,tsx,json,yml,yaml}\"",
        "format:check": "prettier --check \"apps/**/src/**/*.{js,jsx,ts,tsx,vue,css,less,scss}\" \"packages/**/src/**/*.{js,jsx,ts,tsx}\" \"scripts/dev-launcher/web/src/**/*.{js,jsx,ts,tsx,vue,css}\" \"*.{js,jsx,ts,tsx,json,yml,yaml}\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:shared": "pnpm -F @my-app/shared test",
        "prepare": "husky || true",
        "lint-staged": "lint-staged",
        "check:docs": "node scripts/check-docs-drift.mjs"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,vue}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{css,less}": [
            "prettier --write",
            "stylelint --fix"
        ],
        "*.{json,yml,yaml,md}": "prettier --write"
    },
    "devDependencies": {
        "@clack/prompts": "^1.7.0",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@mdi/font": "^7.4.47",
        "@types/jest": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vitejs/plugin-legacy": "^8.2.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitejs/plugin-vue-jsx": "^5.1.6",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "less": "^4.9.0",
        "lint-staged": "^17.3.0",
        "postcss": "^8.5.26",
        "postcss-calc": "^11.0.0",
        "postcss-html": "^2.0.0",
        "postcss-px-to-viewport": "^1.1.1",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "stylelint": "^17.14.1",
        "stylelint-config-recommended-less": "^4.2.1",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-less": "^4.2.1",
        "stylelint-order": "^8.1.1",
        "ts-jest": "^29.4.12",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.0.0"
    }
}

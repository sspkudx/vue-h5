# EditorConfig: https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 项目统一 4 空格缩进（与 .prettierrc.yml 保持一致）
[*.{js,jsx,ts,tsx,vue,json,yml,yaml,less,css,scss}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
